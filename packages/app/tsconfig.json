{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": true,
    "erasableSyntaxOnly": true,
    "paths": {
      "$/*": ["./src/*"]
    }
  },

  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"]
}
