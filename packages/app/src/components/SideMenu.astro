---
interface Props {}

interface Item {
  readonly text: string;
  readonly href: string;
}

interface List {
  readonly summaryText: string;
  readonly prefixPath: string;
  readonly items: readonly Item[];
}

const conlangs: readonly Item[] = [
  { text: '概要', href: '/' },
  { text: 'Venzlendisç', href: '/venz/' },
  { text: 'Jasunielu', href: '/jasu/' },
];

const data: readonly Item[] = [
  { text: '概要', href: '/' },
  { text: '100の質問', href: '/100_shitsumon/' },
  { text: 'Ænglisċ', href: '/aenglisc/' },
  { text: 'Proto-Germanic', href: '/pgmc/' },
  { text: 'Suomi', href: '/suomi/' },
  { text: 'Türkçe', href: '/turkce/' },
];

const miscs: readonly Item[] = [
  { text: '概要', href: '/' },
  { text: 'グレゴリオ聖歌について', href: '/gregorian_chants/' },
  { text: '数学', href: '/math/' },
  { text: '音楽', href: '/musiken/' },
];

const categories: readonly List[] = [
  { summaryText: 'CONLANG', prefixPath: '/conlang', items: conlangs },
  { summaryText: 'DATA', prefixPath: '/data', items: data },
  { summaryText: 'MISC', prefixPath: '/misc', items: miscs },
];

const name = 'sidemenu-accordion';
---

<nav class='__sidemenu-root' aria-label='サイドメニュー'>
  {categories.map(({ summaryText, prefixPath, items }) => {
    return (
      <details {name}>
        <summary>
          <p>{summaryText}</p>
        </summary>
        <div class='__content'>
          <ul>
            {items.map(({ text, href: h_ }) => {
              const href = prefixPath + h_;
              return (
                <li>
                  <a {href}>{text}</a>
                </li>
              );
            })}
          </ul>
        </div>
      </details>
    );
  })}
</nav>

<style lang='postcss'>
  @reference '../styles/app.css';

  @layer components {
    .__sidemenu-root {
      @apply flex flex-col mx-4 my-2 gap-4 sticky inset-bs-2 text-start;
      --sidemenu-dur: 260ms;
    }

    details {
      @apply flow-root;

      &[open] :where(summary),
      a {
        @apply bg-accent text-textinv hover-focus:bg-accent-lighter;
      }

      &::details-content {
        @apply transition-[height,content-visibility] transition-discrete
          duration-(--sidemenu-dur) overflow-y-clip;
      }

      &:not([open])::details-content {
        @apply block-0;
      }

      &[open]::details-content {
        @apply block-(--open-height,max-content);
      }
    }

    summary {
      @apply block cursor-pointer px-2 py-1
        text-3xl font-extralight
        hover-focus:bg-accent hover-focus:text-textinv
        select-none;
    }

    summary, a {
      @apply transition-colors;
    }

    /* for Safari */
    summary::-webkit-details-marker {
      @apply hidden;
    }

    ul {
      @apply flex flex-col list-none m-0;
    }

    li {
      @apply block m-0;
    }

    a {
      @apply block px-3 py-1 no-underline;
    }
  }
</style>

<script>
  import { cannotGetHandler } from '../modules/helpers';

  const d_ = document.querySelectorAll('.__sidemenu-root > details');

  const dAndCSet = Array.from(d_, (details) => {
    if (!(details instanceof HTMLDetailsElement)) {
      cannotGetHandler('details', HTMLDetailsElement.prototype, details);
    }

    const content = details.querySelector('.__content');

    if (!(content instanceof HTMLDivElement)) {
      cannotGetHandler('content', HTMLDivElement.prototype, content);
    }

    return [details, content] as const;
  });

  const setOpenHeight = () => {
    dAndCSet.forEach(([details, content]) => {
      const openHeight = `${content.scrollHeight + 1}px`;
      details.style.setProperty('--open-height', openHeight);
    });
  };

  setOpenHeight();

  let id: ReturnType<typeof setTimeout> | undefined;

  window.addEventListener('resize', () => {
    clearTimeout(id);

    id = setTimeout(() => {
      setOpenHeight();
      id = undefined;
    }, 100);
  });
</script>
