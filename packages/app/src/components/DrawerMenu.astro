---
import SideMenu from './SideMenu.astro';
---

<dialog id='sidemenu-drawer' closedby='any'>
  <button
    type='button'
    id='sidemenu-drawer-close-btn'
    class='btn-theme-1'
    aria-label='サイドメニューを閉じる'
  ></button>
  <SideMenu />
</dialog>

<button
  type='button'
  id='sidemenu-drawer-open-btn'
  class='btn-theme-1'
  aria-label='サイドメニューを開く'
>
  <span></span>
  <span></span>
  <span></span>
</button>

<style lang='postcss'>
  @reference '../styles/app.css';

  @layer components {
    #sidemenu-drawer {
      @apply flex flex-col gap-2 py-2 max-inline-90 me-auto bg-main;

      &::backdrop {
        @apply bg-black/40;
      }

      &:not([open]) {
        @apply -translate-x-full;
      }

      &[open] {
        @apply translate-x-0 starting:-translate-x-full;
      }

      &:not([open])::backdrop {
        @apply opacity-0;
      }

      &[open]::backdrop {
        @apply opacity-100 starting:opacity-0;
      }

      &,
      &::backdrop {
        @apply transition-[opacity,translate,display,overlay] transition-discrete duration-200;
      }
    }

    #sidemenu-drawer-open-btn {
      @apply max-lg:flex lg:hidden flex-col fixed inset-s-2 inset-bs-2 gap-2 p-2;

      > span {
        @apply border-bs inline-4.75;
      }
    }

    #sidemenu-drawer-close-btn {
      @apply self-start ms-4 grid px-2 py-4.25 place-content-center-safe;

      &::before, &::after {
        content: '';
        @apply col-span-full row-span-full border-bs inline-4.75;
      }

      &::before {
        @apply rotate-45;
      }

      &::after {
        @apply -rotate-45;
      }
    }
  }
</style>

<script>
  import { getElementById } from '../modules/helpers';
  import { setOpenHeight } from '../modules/sidemenu_helpers';

  const drawer = getElementById('sidemenu-drawer', HTMLDialogElement);
  const openBtn = getElementById('sidemenu-drawer-open-btn', HTMLButtonElement);
  const closeBtn = getElementById(
    'sidemenu-drawer-close-btn',
    HTMLButtonElement,
  );

  openBtn.addEventListener('click', (ev) => {
    ev.preventDefault();
    drawer.showModal();

    requestAnimationFrame(() => {
      setOpenHeight();
    });
  });

  closeBtn.addEventListener('click', (ev) => {
    ev.preventDefault();
    drawer.close();
  });
</script>
