---
interface Props {}
---

<button type='button' id='to-top-btn' aria-label='ページトップに戻る'></button>

<style lang='postcss'>
  @reference '$/styles/app.css';

  @layer components {
    #to-top-btn {
      @apply hidden fixed inset-e-6 inset-be-6
        p-4 rounded-sm bg-accent opacity-0
        transition-[background-color,opacity,display] transition-discrete;

      @apply hover-focus:bg-accent/70;

      &[data-visible] {
        @apply grid opacity-100 starting:opacity-0;
      }
    }

    #to-top-btn::before {
      content: '';
      @apply size-2 border-l-2 border-t-2 border-textinv
        translate-y-0.5 rotate-45 transition-transform;
    }

    @media (any-hover: hover) {
      #to-top-btn:hover::before {
        @apply -translate-y-px;
      }
    }

    #to-top-btn:focus-visible::before {
      @apply -translate-px;
    }
  }
</style>

<script>
  import { getElementById } from '$/modules/helpers';

  const toTopBtn = getElementById('to-top-btn', HTMLButtonElement);
  let id: ReturnType<typeof setTimeout> | undefined;

  toTopBtn.addEventListener('click', (ev) => {
    ev.preventDefault();
    window.scroll({ top: 0, behavior: 'smooth' });
  });

  document.addEventListener('scroll', () => {
    clearTimeout(id);

    id = setTimeout(() => {
      if (scrollY > 400) {
        toTopBtn.setAttribute('data-visible', '');
      } else {
        toTopBtn.removeAttribute('data-visible');
      }
      id = undefined;
    }, 100);
  });
</script>
