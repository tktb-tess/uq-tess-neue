---

<nav aria-label='サイドメニュー'>
  <details name='side-menu-drawers'>
    <summary>CONLANGS</summary>
    <ul></ul>
  </details>
  <details name='side-menu-drawers'>
    <summary>DATA</summary>
    <ul></ul>
  </details>
  <details name='side-menu-drawers'>
