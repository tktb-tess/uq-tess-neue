---
interface Props {}

interface Item {
  readonly text: string;
  readonly href: string;
}

const conlangs: readonly Item[] = [
  { text: 'Venzlendisç', href: '/venz/' },
  { text: 'Venzlendisç 音韻論', href: '/venz/phonology/' },
  { text: 'Venzlendisç 正書法', href: '/venz/orthography/' },
