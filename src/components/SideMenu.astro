  </details>
</nav>

<style lang="postcss">
  @reference '../styles/app.css';

  @layer components {
    nav {
      @apply flex flex-col;
    }

    details {
      @apply block;
    }

    summary {
      @apply grid;
    }

    /** for Safari */
    summary::-webkit-details-marker {
      @apply hidden;
    }
  }
</style>
