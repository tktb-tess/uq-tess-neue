---
interface Props {
  readonly data: {
    readonly title: string;
    readonly desc: string;
    readonly href: string;
  }[];
}

const { data } = Astro.props;
---

<ul class='__card-list'>
  {
    data.map(({ title, desc, href }) => {
      return (
        <li>
          <a {href}>
            <h3>{title}</h3>
            <p>{desc}</p>
          </a>
        </li>
      );
    })
  }
</ul>

<style lang="postcss">
  @reference '../styles/app.css';

  @layer components {
    h3, p {
      @apply m-0 text-text;
    }

    .__card-list {
      @apply grid grid-cols-[auto_1fr];

      > li {
        @apply contents;
      }

      > * > a {
        @apply grid grid-cols-subgrid col-span-full;
      }
    }
  }
</style>
