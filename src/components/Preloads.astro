---
interface Props {
  readonly katex?: boolean;
}

const { katex = false } = Astro.props;
---

<!-- fonts -->
<link
  rel='stylesheet'
  href='https://api.tktb-tess.dev/fonts/Inter/font-face.css'
  crossorigin='anonymous'
/>
<link
  rel='stylesheet'
  href='https://api.tktb-tess.dev/fonts/Charis/font-face.css'
  crossorigin='anonymous'
/>

<!-- Google Fonts -->
<link rel='preconnect' href='https://fonts.googleapis.com' />
<link
  rel='preconnect'
  href='https://fonts.gstatic.com'
  crossorigin='anonymous'
/>
<link
  href='https://fonts.googleapis.com/css2?family=Noto+Sans+Canadian+Aboriginal:wght@100..900&family=Noto+Sans+JP:wght@100..900&family=Noto+Serif+JP:wght@200..900&family=Noto+Serif+Tibetan:wght@100..900&display=swap'
  rel='stylesheet'
/>

<!-- KaTeX CSS -->
{
  () => {
    if (katex) {
      return (
        <link
          rel='stylesheet'
          href='https://cdn.jsdelivr.net/npm/katex@0.16.27/dist/katex.min.css'
          integrity='sha384-Pu5+C18nP5dwykLJOhd2U4Xen7rjScHN/qusop27hdd2drI+lL5KvX7YntvT8yew'
          crossorigin='anonymous'
        />
      );
    }
  }
}
