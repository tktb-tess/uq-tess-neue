---
interface Props {
  readonly title: string;
}

const { title } = Astro.props;
---

<div class='__header-root'>
  <h1>{title}</h1>
</div>

<style lang="postcss">
  @reference '../styles/app.css';

  @layer components {
    .__header-root {
      @apply grid place-content-center py-12;
    }

    h1 {
      @apply text-4xl 2xl:text-5xl font-extralight;
    }
  }
</style>