---
interface Props {
  readonly title: string;
}

const { title } = Astro.props;
---

<div class='__header-root'>
  <h1>{title}</h1>
</div>

<style lang="postcss">
  @reference '../styles/app.css';

  @layer components {
    .__header-root {
      @apply py-12;
    }

    h1 {
      @apply text-4xl xl:text-5xl font-title font-extralight text-center text-balance;
    }
  }
</style>