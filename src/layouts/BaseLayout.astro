---
import '../styles/app.css';
import OGP from '../components/OGP.astro';
import Preloads from '../components/Preloads.astro';
import ToTopBtn from '../components/ToTopBtn.astro';
import { getPageData, type PageData } from '../modules/data';
import { SITE_NAME } from '../modules/consts';

interface Props {
  readonly pageData?: PageData;
}

const pathname = Astro.originPathname;
const { title, description } = Astro.props.pageData ?? getPageData(pathname);
const isHome = pathname === '/';
const fullTitle = isHome ? SITE_NAME : `${title} | ${SITE_NAME}`;
---

<!doctype html>
<html lang='ja'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width' />
    <link rel='icon' type='image/svg+xml' href='/icon.svg' />
    <meta name='generator' content={Astro.generator} />
    <Preloads />
    <OGP title={fullTitle} {description} path={pathname} />
    <title>{fullTitle}</title>
  </head>
  <body>
    <slot />
    <ToTopBtn />
  </body>
</html>

<style lang="postcss">
  @reference '../styles/app.css';

  @layer components {
    body {
      @apply flow-root bg-main text-text;
    }
  }
</style>
