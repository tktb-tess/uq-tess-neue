---
import ArticleLayout from './ArticleLayout.astro';
import type { MarkdownLayoutProps } from 'astro';
import type { PageData } from '../modules/typedef';

type Props = MarkdownLayoutProps<PageData>;

const { title, description } = Astro.props.frontmatter;
---

<ArticleLayout {title} {description}>
  <slot />
</ArticleLayout>
