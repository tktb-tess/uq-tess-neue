---
import type { PageData } from '../modules/typedef';
import BaseLayout from './BaseLayout.astro';

type Props = PageData;

const { title, description } = Astro.props;
---

<BaseLayout {title} {description}>
  <div class='__container'>
    <header></header>
    <aside></aside>
    <main>
      <div class='__main-contents'>
        <slot />
      </div>
    </main>
    <aside></aside>
    <footer></footer>
  </div>
</BaseLayout>
