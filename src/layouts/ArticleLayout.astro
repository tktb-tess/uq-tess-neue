---
import BaseLayout from './BaseLayout.astro';
import BreadCrumb from '../components/BreadCrumb.astro';
import XFooter from '../components/XFooter.astro';
import XHeader from '../components/XHeader.astro';
import SideMenu from '../components/SideMenu.astro';
import { getPageData, type PageData } from '../modules/data';
import { SITE_NAME } from '../modules/consts';

interface Props {
  readonly pageData?: PageData;
}

const { pageData } = Astro.props;

const pathname = Astro.originPathname;
const { title } = pageData ?? getPageData(pathname);
const isHome = pathname === '/';
const h1Title = isHome ? SITE_NAME : title;
---

<BaseLayout {pageData}>
  <div class='__container'>
    <header>
      <XHeader title={h1Title} />
    </header>
    <aside class='__lside'>
      <SideMenu />
    </aside>
    <main>
      <BreadCrumb path={pathname} />
      <div class='__main-contents'>
        <slot />
      </div>
    </main>
    <aside class='__rside'></aside>
    <footer>
      <XFooter />
    </footer>
  </div>
</BaseLayout>

<style lang="postcss">
  @reference '../styles/app.css';

  @layer components {
    .__container {
      @apply max-xl:flow-root xl:grid;

      grid-template-areas:
        'h h h'
        'l m r'
        'f f f';

      grid-template-columns:
        minmax(min(var(--spacing-min-side), 50%), 1fr)
        minmax(0, var(--spacing-max-main))
        minmax(min(var(--spacing-min-side), 50%), 1fr);

      grid-template-rows: auto 1fr auto;

      header,
      main,
      footer {
        @apply flow-root;
      }

      aside {
        @apply max-xl:hidden xl:flow-root;
      }

      header,
      footer {
        @apply bg-side;
      }

      header {
        grid-area: h;
      }

      main {
        @apply px-gutter pbe-36 bg-main min-block-lvh border-x border-border;
        grid-area: m;
      }

      footer {
        grid-area: f;
      }

      .__lside {
        grid-area: l;
      }

      .__rside {
        grid-area: r;
      }
    }
  }
</style>
