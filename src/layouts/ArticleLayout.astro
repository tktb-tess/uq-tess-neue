---
import { getPageData, type PageData } from '../modules/data';
import BaseLayout from './BaseLayout.astro';
import { SITE_NAME } from '../modules/consts';

interface Props {
  readonly pageData?: PageData;
}

const { pageData } = Astro.props;

const pathname = Astro.originPathname;
const { title } = pageData ?? getPageData(pathname);
const isHome = pathname === '/';
const h1Title = isHome ? SITE_NAME : title;
---

<BaseLayout {pageData}>
  <div class='__container'>
    <header></header>
    <aside class='__lside'></aside>
    <main>
      <h1>{h1Title}</h1>
      <div class='__main-contents'>
        <slot />
      </div>
    </main>
    <aside class='__rside'></aside>
    <footer></footer>
  </div>
</BaseLayout>

<style lang="postcss">
  @reference '../styles/app.css';

  @layer components {
    .__container {
      @apply max-xl:flow-root xl:grid bg-side text-text;

      grid-template-areas:
        'h h h'
        'l m r'
        'f f f';

      grid-template-columns:
        minmax(min(var(--spacing-min-side), 50%), 1fr)
        minmax(0, var(--spacing-max-main))
        minmax(min(var(--spacing-min-side), 50%), 1fr);

      grid-template-rows: auto 1fr auto;

      header,
      main,
      footer,
      aside {
        @apply flow-root;
      }

      header {
        grid-area: h;
      }

      main {
        @apply px-4 pbe-36 bg-main min-block-lvh;
        grid-area: m;
      }

      footer {
        grid-area: f;
      }

      .__lside {
        grid-area: l;
      }

      .__rside {
        grid-area: r;
      }
    }
  }
</style>
