---
import type { PageData } from '../modules/typedef';
import BaseLayout from './BaseLayout.astro';

type Props = PageData;

const { title, description } = Astro.props;
---

<BaseLayout {title} {description}>
  <div class='__container'>
    <header></header>
    <aside></aside>
    <main>
      <div class='__main-contents'>
        <slot />
      </div>
    </main>
    <aside></aside>
    <footer></footer>
  </div>
</BaseLayout>

<style lang="postcss">
  @import '../styles/app.css';

  @layer components {
    .__container {
      @apply max-xl:flow-root xl:grid bg-side text-text;

      grid-template-areas:
        'h h h'
        'l m r'
        'f f f';

      grid-template-columns:
        minmax(min(var(--spacing-min-side), 50%), 1fr)
        minmax(0, var(--spacing-max-main))
        minmax(min(var(--spacing-min-side), 50%), 1fr);

      grid-template-rows: auto 1fr auto;

      header,
      main,
      footer {
        @apply flow-root;
      }

      header {
        grid-area: h;
      }

      main {
        @apply px-4 pbe-36 bg-main min-block-lvh;
        grid-area: m;
      }

      footer {
        grid-area: f;
      }
    }
  }
</style>
