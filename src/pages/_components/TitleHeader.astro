---
import { SITE_NAME } from '../../modules/consts';

interface Props {}
---

<div class='__title-header-root'>
  <div class='__logo' id='site-logo'>
    <img src='/site_logo_weiss.svg' alt='サイトロゴ' />
  </div>
  <h1 class='__name'>{SITE_NAME}</h1>
</div>

<style lang="postcss">
  @reference '../../styles/app.css';

  @layer components {
    .__title-header-root {
      @apply grid block-lvh grid-rows-[2fr_1fr] place-items-center-safe py-12 overflow-clip bg-black text-white;
      --start: hsl(270 100 40 / 40%);
      background-image: linear-gradient(to bottom right in oklch, var(--start), transparent 80%);
    }
    
    .__logo {
      @apply animate-up-down reduced-motion:animate-none block-full;

      > img {
        @apply animate-rot-fadein reduced-motion:animate-none block-[min(90%,90lvw)];
      }

      &[data-happy] {
        @apply animate-none;

        > img {
          @apply animate-happy-fadein reduced-motion:animate-none;
        }
      }
    }

    .__name {
      @apply mx-auto px-6 text-7xl 2xl:text-8xl font-title font-extralight italic -skew-4;
      text-align-last: justify;
      inline-size: min(960px, 100%);
    }
  }
</style>

<script>
  import { cannotGetHandler } from '../../modules/helpers';

  const url = new URL(document.URL);
  const happy = url.searchParams.get('happy');
  const siteLogo = document.getElementById('site-logo');

  if (!(siteLogo instanceof HTMLDivElement)) {
    cannotGetHandler('siteLogo', HTMLDivElement.prototype, siteLogo);
  }

  if (happy === 'true' || Math.random() < 0.1) {
    siteLogo.setAttribute('data-happy', '');
  }
</script>
