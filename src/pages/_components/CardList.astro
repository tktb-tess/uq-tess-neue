---
interface Props {
  readonly data: {
    readonly title: string;
    readonly desc: string;
    readonly href: string;
  }[];
}

const { data } = Astro.props;
---

<ul class='__card-list'>
  {
    data.map(({ title, desc, href }) => {
      return (
        <li>
          <a {href}>
            <h3>{title}</h3>
            <p>{desc}</p>
          </a>
        </li>
      );
    })
  }
</ul>

<style lang="postcss">
  @reference '../../styles/app.css';

  @layer components {
    .__card-list {
      @apply grid grid-cols-[auto_1fr] gap-4 place-content-center max-inline-180 mx-auto;

      > li {
        @apply contents;
      }

      a {
        @apply grid grid-cols-subgrid col-span-full no-underline bg-accent px-4 py-2
          rounded-sm hover-focus:bg-accent/80 transition-colors;
      }

      h3, p {
        @apply text-textinv m-0 self-center-safe;
      }

      h3 {
        @apply justify-self-end-safe font-title font-extralight;
      }
    }
  }
</style>
