---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {}
---

<BaseLayout>
  <div class='__404-root'>
    <div class='__logo-wrapper'>
      <img
        height='240'
        width='240'
        src='/site_logo_weiss.svg'
        alt='高速回転するサイトロゴ'
      />
    </div>
    <h2>Hoppla!</h2>
    <p>
      お探しのページは見つかりませんでした。移動あるいは削除された可能性があります。
    </p>
    <a class='__btn' href='/.'>トップへ戻る</a>
  </div>
</BaseLayout>

<style lang="postcss">
  @reference '../styles/app.css';

  @layer components {
    h2, p {
      @apply m-[unset] p-[unset] text-center text-white;
    }

    h2 {
      @apply font-sans font-extralight max-lg:text-4xl lg:text-5xl;
      border: unset;
    }

    .__404-root {
      @apply grid grid-rows-[repeat(4,auto)] py-6
        gap-6 min-block-lvh bg-black place-items-center-safe place-content-center-safe;
    }

    .__btn {
      @apply block bg-white hover-focus:bg-white/70 text-black
      transition-colors rounded px-4 py-2 no-underline leading-none;
    }

    .__logo-wrapper {
      @apply animate-rot-fast-y reduced-motion:animate-none block-full;

      > img {
        @apply animate-rot-fast-z reduced-motion:animate-none;
      }
    }
  }
</style>
