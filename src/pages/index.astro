---
import BaseLayout from '../layouts/BaseLayout.astro';
import TitleHeader from '../components/TitleHeader.astro';
import Footer from '../components/Footer.astro';
import ExtLink from '../components/ExtLink.astro';
import CardList from '../components/CardList.astro';
import XTable from '../components/XTable.astro';

interface Props {}
---

<BaseLayout pageData={{ title: '' }}>
  <div class='__container'>
    <header>
      <TitleHeader />
    </header>
    <aside class='__lside'></aside>
    <main>
      <h2>〜ようこそ〜</h2>
      <p>
        ※ただいま大改訂中です。現行のバージョンではここに書かれている内容と大きく異なる可能性があります。
      </p>
      <p>
        わたし、斗琴庭 暁響 (とことば あかね)
        が作っている創作言語をはじめとした諸創作物についてをまとめているサイトです。
      </p>
      <h2>メニュー</h2>

      <CardList
        data={[
          {
            title: '人工言語',
            desc: '制作中の人工言語について。',
            href: '/conlang/',
          },
          { title: 'データ', desc: '各種データ。', href: '/data/' },
          { title: 'その他', desc: 'その他の雑多な話題。', href: '/misc/' },
        ]}
      />

      <h2>頂いた名前</h2>

      <XTable
        data={[
          ['種類', '作者', '名'],
          [
            [
              '<a href="https://kaeru2193.net/phunlang/name/" target="_blank">雰名</a>',
              { rawHTML: true },
            ],
            'かえる',
            [
              '<span lang="x-v3-karphnpn">常代 方累</span> (常代 方累, Xûyâo Zùngwíl)',
              { rawHTML: true },
            ],
          ],
        ]}
        headColNum={0}
      />
      <h2>相互リンク</h2>

      <p>
        敬称略。追加や削除を希望される方は、下記SNSなどより連絡お願いします。
      </p>

      <div class='flex my-figure'>
        <a href='https://kaeru2193.net' target='_blank' class='block'>
          <img
            src='https://kaeru2193.net/banner.png'
            width='200'
            height='40'
            alt='之機堂'
          />
        </a>
      </div>

      <h2>外部リンク</h2>

      <h3>各種SNS</h3>

      <ul>
        <li>
          <p>
            <ExtLink href='https://x.com/triethylamineq'>𝕏witter</ExtLink>
          </p>
        </li>
        <li>
          <p>
            <ExtLink href='https://bsky.app/profile/tktb-tess.dev'>
              Bluesky
            </ExtLink>
          </p>
        </li>
        <li>
          <p>
            <ExtLink href='https://misskey.io/@tessy_tktb'>Misskey.io</ExtLink>
          </p>
        </li>
      </ul>

      <h3>その他</h3>

      <ul>
        <li>
          <p>
            <ExtLink href='https://www.youtube.com/@tessyrrhaqt'>
              Youtube
            </ExtLink>
          </p>
        </li>
        <li>
          <p>
            <ExtLink href='https://rechord.cc/users/triethylamineq'>
              rechord
            </ExtLink>
          </p>
        </li>
        <li>
          <p>
            <ExtLink href='https://migdal.jp/tessyrrhaqt'>Migdal</ExtLink>
          </p>
        </li>
        <li>
          <p>
            <ExtLink href='https://github.com/tktb-tess'>GitHub</ExtLink>
          </p>
        </li>
        <li>
          <p>
            <ExtLink href='https://tktb-tess.github.io'>
              tktb-tess.github.io
            </ExtLink>
          </p>
        </li>
        <li>
          <p>
            <ExtLink href='https://apps.tktb-tess.dev'>
              τὰ συστήματα (作ったアプリたち)
            </ExtLink>
          </p>
        </li>
        <li>
          <p>
            <ExtLink
              href='https://docs.google.com/spreadsheets/d/1rxeounm1eLGbv_KaIC7LGAdRiBZIWSWZON2EQZz6Y-0/edit'
            >
              Xenharmonic_calc
            </ExtLink>
          </p>
        </li>
      </ul>
    </main>
    <aside class='__rside'></aside>
    <footer>
      <Footer />
    </footer>
  </div>
</BaseLayout>

<style lang="postcss">
  @reference '../styles/app.css';

  @layer components {
    .__container {
      @apply max-xl:flow-root xl:grid;

      grid-template-areas:
        'h h h'
        'l m r'
        'f f f';

      grid-template-columns:
        minmax(min(var(--spacing-min-side), 50%), 1fr)
        minmax(0, var(--spacing-max-main))
        minmax(min(var(--spacing-min-side), 50%), 1fr);

      grid-template-rows: auto 1fr auto;

      header,
      main,
      footer,
      aside {
        @apply flow-root;
      }

      header,
      footer,
      aside {
        @apply bg-side;
      }

      header {
        grid-area: h;
      }

      main {
        @apply px-4 pbe-36 bg-main min-block-lvh;
        grid-area: m;
      }

      footer {
        grid-area: f;
      }

      .__lside {
        grid-area: l;
      }

      .__rside {
        grid-area: r;
      }
    }
  }
</style>
