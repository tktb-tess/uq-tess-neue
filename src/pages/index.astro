---
import BaseLayout from '../layouts/BaseLayout.astro';
import TitleHeader from './_components/TitleHeader.astro';
import XFooter from '../components/XFooter.astro';
import CardList from './_components/CardList.astro';
import ExtLink from '../components/ExtLink.astro';
import ExtLinkList from './_components/ExtLinkList.astro';
import Heading from './_components/Heading.astro';
import TodayWord from './_components/TodayWord.svelte';

interface Props {}
---

<BaseLayout pageData={{ title: '' }}>
  <div class='__container'>
    <header>
      <TitleHeader />
    </header>
    <aside class='__lside'></aside>
    <main>
      <h2 class='__youkoso'>〜ようこそ〜</h2>
      <p>
        ※ただいま大改訂中です。現行のバージョンではここに書かれている内容と大きく異なる可能性があります。
      </p>
      <p>
        わたし、斗琴庭 暁響 (とことば あかね)
        が作っている創作言語をはじめとした諸創作物についてをまとめているサイトです。
      </p>

      <Heading h='h2' text='今日の単語' />
      <TodayWord client:load />

      <Heading h='h2' text='メニュー' />

      <CardList
        data={[
          {
            title: '人工言語',
            desc: '制作中の人工言語について。',
            href: '/conlang/',
          },
          { title: 'データ', desc: '各種データ。', href: '/data/' },
          { title: 'その他', desc: 'その他の雑多な話題。', href: '/misc/' },
        ]}
      />

      <Heading h='h2' text='頂いた名前' />

      <div class='table-container'>
        <table>
          <thead>
            <tr>
              <th>種類</th>
              <th>作者</th>
              <th>名</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>
                <ExtLink href='https://kaeru2193.net/phunlang/name/'>
                  雰名
                </ExtLink>
              </td>
              <td>かえる</td>
              <td>
                <span lang='x-v3-karphnpn'>常代 方累</span> (常代 方累, Xûyâo Zùngwíl)
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <Heading h='h2' text='相互リンク' />

      <p>
        敬称略。追加や削除を希望される方は、下記SNSなどより連絡お願いします。
      </p>

      <div class='table-container'>
        <table class='__mut-links'>
          <thead>
            <tr>
              <th>管理者</th>
              <th>サイトバナー</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>かえる</td>
              <td>
                <a href='https://kaeru2193.net' target='_blank'>
                  <img
                    src='https://kaeru2193.net/banner.png'
                    width='200'
                    height='40'
                    alt='之機堂'
                  />
                </a>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <Heading h='h2' text='外部リンク' />

      <Heading h='h3' text='各種SNS' />

      <ExtLinkList
        links={[
          { text: '𝕏witter', href: 'https://x.com/triethylamineq' },
          { text: 'Bluesky', href: 'https://bsky.app/profile/tktb-tess.dev' },
          { text: 'Misskey.io', href: 'https://misskey.io/@tessy_tktb' },
        ]}
      />

      <Heading h='h3' text='その他' />

      <ExtLinkList
        links={[
          { text: 'Youtube', href: 'https://www.youtube.com/@tessyrrhaqt' },
          { text: 'rechord', href: 'https://rechord.cc/users/triethylamineq' },
          { text: 'Migdal', href: 'https://migdal.jp/tessyrrhaqt' },
          { text: 'GitHub', href: 'https://github.com/tktb-tess' },
          { text: 'tktb-tess.github.io', href: 'https://tktb-tess.github.io' },
          {
            text: 'τὰ συστήματα (作ったアプリたち)',
            href: 'https://apps.tktb-tess.dev',
          },
          {
            text: 'Xenharmonic_calc',
            href: 'https://docs.google.com/spreadsheets/d/1rxeounm1eLGbv_KaIC7LGAdRiBZIWSWZON2EQZz6Y-0/edit',
            desc: '…各平均律の特定音程への近似度合い、特定コンマをテンパーアウトするかどうかの計算ができるスプレッドシート。',
          },
        ]}
      />
    </main>
    <aside class='__rside'></aside>
    <footer>
      <XFooter />
    </footer>
  </div>
</BaseLayout>

<style lang="postcss">
  @reference '../styles/app.css';

  @layer components {
    .__container {
      @apply max-xl:flow-root xl:grid;

      grid-template-areas:
        'h h h'
        'l m r'
        'f f f';

      grid-template-columns:
        minmax(min(var(--spacing-min-side), 50%), 1fr)
        minmax(0, var(--spacing-max-main))
        minmax(min(var(--spacing-min-side), 50%), 1fr);

      grid-template-rows: auto 1fr auto;

      header,
      main,
      footer {
        @apply flow-root;
      }

      aside {
        @apply max-xl:hidden xl:flow-root;
      }

      header,
      footer,
      aside {
        @apply bg-side;
      }

      header {
        grid-area: h;
      }

      main {
        @apply px-4 pbe-36 bg-main min-block-lvh;
        grid-area: m;
      }

      footer {
        grid-area: f;
      }

      .__lside {
        grid-area: l;
      }

      .__rside {
        grid-area: r;
      }
    }

    .__youkoso {
      @apply my-figure text-center p-0 border-none;
    }

    .__mut-links > tbody a {
      @apply block;
    }
  }
</style>
